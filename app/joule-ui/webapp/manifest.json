{
  "_version": "1.65.0",
  "sap.app": {
    "id": "bid.pilot.joule",
    "type": "application",
    "title": "BidPilot — Joule Interface",
    "description": "AI-assisted bid intake — Joule-style conversational UI",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": { "icon": "sap-icon://ai" },
    "deviceTypes": { "desktop": true, "tablet": true, "phone": false }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "bid.pilot.joule.view.Main",
      "type": "XML",
      "id": "mainView"
    },
    "models": {
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": { "compact": true, "cozy": true },
    "resources": {
      "css": [{ "uri": "css/style.css" }]
    }
  }
}
