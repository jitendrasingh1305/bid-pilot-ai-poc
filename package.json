{
  "name": "bid-pilot-poc",
  "version": "1.0.0",
  "description": "SAP Bidding Assistant POC — AI-assisted bid lifecycle management on BTP",
  "engines": { "node": ">=18" },
  "dependencies": {
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "express": "^4",
    "hdb": "^0.19",
    "passport": "^0",
    "axios": "^1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds watch",
    "build": "cds build --production"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "[production]": { "kind": "hana" }
      },
      "auth": {
        "kind": "mocked",
        "[production]": { "kind": "xsuaa" }
      }
    },
    "features": {
      "fiori_preview": true
    }
  }
}
